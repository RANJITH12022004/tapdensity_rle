[Unit]
Description=Keep HDMI console on kiosk virtual terminal (tty2)
DefaultDependencies=no
After=local-fs.target
Before=getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
ExecStart=/bin/bash /opt/kiosk/scripts/kiosk_console_vt.sh
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
