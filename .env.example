# Tap Density - copy to .env and adjust
# On Pi: internal pendrive sda1 is mounted at /media/usb_internal (see /etc/fstab).

APP_ROOT=.
INTERNAL_USB_PATH=/media/usb_internal
STORAGE_DIR=/media/usb_internal/storage
REPORTS_DIR=/media/usb_internal/reports
AUDIT_DB_DIR=/media/usb_internal/db
INTERNAL_USB_UUIDS=9607-EF05
EXPORT_USB_PATH=./export

# MCU serial (for tap density / simulated data)
ESP_PORT=/dev/serial0
ESP_BAUD=9600

# R307 fingerprint sensor (GPIO12/13 -> /dev/ttyAMA5)
BIOMETRIC_PORT=/dev/ttyAMA5
BIOMETRIC_BAUD=57600
BIOMETRIC_ENROLL_TIMEOUT_SEC=12
BIOMETRIC_LOGIN_TIMEOUT_SEC=10

# Printers
A4_PORT=/dev/ttyAMA4
A4_BAUD=9600
THERMAL_PORT=/dev/ttyAMA3
THERMAL_BAUD=9600

# Flask
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
